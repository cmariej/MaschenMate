{
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/app-config.js",
          "/favicon.ico",
          "/favicon-*.png",
          "/icons/*.png",
          "/*.js",
          "/*.css"
        ]
      }
    },
    {
      "name": "pdf-viewer",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/pdfjs/**"] }
    }
  ]
}
